# Copy this file to .env and fill in your own values.
# Weather and news work fine with the defaults below; the calendar needs a real URL.

# --- Location (used for the Open-Meteo weather lookup) ---
# Defaults to Utrecht, NL.
LATITUDE=52.09
LONGITUDE=5.12
# IANA timezone name used for the hourly forecast timestamps.
TIMEZONE=Europe/Amsterdam

# Hours between columns in the forecast strip (2 = 08:00, 10:00, 12:00, ...).
WEATHER_HOURLY_STEP=2
# Number of columns in the forecast strip.
WEATHER_HOURLY_COUNT=5

# --- News ---
# NOS general news. Other NOS feeds exist per category, e.g.:
#   https://feeds.nos.nl/nosnieuwsbinnenland
#   https://feeds.nos.nl/nosnieuwsbuitenland
#   https://feeds.nos.nl/nossportalgemeen
NEWS_FEED_URL=https://feeds.nos.nl/nosnieuwsalgemeen
# How many headlines to fetch. The news block is last in the layout priority
# order and fills whatever space is left, so this is a ceiling, not a count.
NEWS_ITEM_COUNT=8

# --- Calendar ---
# Google Calendar -> Settings -> Settings for my calendars -> <your calendar>
# -> Integrate calendar -> "Secret address in iCal format". Keep this private.
GOOGLE_CALENDAR_ICS_URL=replace-with-your-secret-ical-url
# Upper bound on events fetched, then capped per section when drawn.
CALENDAR_EVENT_COUNT=10
CALENDAR_EVENTS_TODAY=4
CALENDAR_EVENTS_TOMORROW=2
# How many days ahead to expand (including recurring) events for.
CALENDAR_LOOKAHEAD_DAYS=1

# --- Display ---
# "preview" writes output/preview.png (default, use this on a PC).
# "real" pushes the image to an attached Waveshare e-paper HAT (Raspberry Pi only).
EPAPER_MODE=preview
# Waveshare driver module name inside the waveshare_epd package.
EPAPER_PANEL_MODEL=epd7in5_V2
# Rotation applied to the 480x800 portrait canvas to suit the landscape panel.
# If the dashboard comes out upside down, change 90 to 270.
EPAPER_ROTATE=90
# Set to false to skip the white flash before each refresh (faster, but
# ghosting will build up over time).
EPAPER_CLEAR_FIRST=true

# --- Fonts ---
# Text face (headers, titles, body).
FONT_REGULAR_PATH=fonts/DejaVuSans.ttf
FONT_BOLD_PATH=fonts/DejaVuSans-Bold.ttf
# Numerals: temperatures and clock times. Variable font; weights are selected
# per role in render.py.
FONT_NUMBER_PATH=fonts/Oswald.ttf
